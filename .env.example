# ==============================================================================
# Alimentador Automático - Environment Variables Template
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# ==============================================================================

# Active Spring Profile (dev | prod)
SPRING_PROFILES_ACTIVE=prod

# Server Port (mapped to host)
PORT=8080

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=feeder
POSTGRES_USER=feeder
POSTGRES_PASSWORD=change_this_to_a_strong_password

# Database URL used by the Spring Boot application (matches service 'db' in docker-compose.prod.yml)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/feeder
SPRING_DATASOURCE_USERNAME=feeder
SPRING_DATASOURCE_PASSWORD=change_this_to_a_strong_password

# Optional Connection Pool settings
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ------------------------------------------------------------------------------
# Authentication & Security (Validated at startup by AuthProperties)
# ------------------------------------------------------------------------------
# OAuth 2.0 Client ID created in Google Cloud Console
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# HS256 secret key for signing internal application JWTs (must be at least 32 characters)
JWT_SECRET=replace-with-a-secure-random-key-at-least-32-chars-long

# Comma-separated allowed frontend origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://seu-dominio.com
